aws_region        = "us-east-1"
availability_zones = ["us-east-1a", "us-east-1b"]

# Replace with your current public IP before applying.
admin_cidr_blocks = ["203.0.113.10/32"]

project_name = "vpn-demo"
environment  = "lab"

# A NAT gateway is required for the default EKS node group to bootstrap and
# pull images. It incurs hourly and data-processing charges.
enable_nat_gateway = true

# Leave false for the default OpenVPN NAT mode. Enable only after configuring
# OpenVPN AS to preserve VPN client source addresses.
enable_vpn_routing_mode = false

openvpn_instance_type = "t3.small"
eks_node_instance_types = ["t3.medium"]
eks_node_desired_size   = 2
eks_node_min_size       = 1
eks_node_max_size       = 3

# Optional long-lived IAM role for SRE cluster administration.
# eks_admin_principal_arn = "arn:aws:iam::123456789012:role/sre"

db_instance_class      = "db.t4g.micro"
db_allocated_storage   = 20
db_deletion_protection = false

additional_tags = {
  Owner = "your-name"
}
